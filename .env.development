# v1 worktree development environment
#
# This file isolates v1 development from v0.3 production data.
# DO NOT commit this file (it's per-machine).
#
# Reference: ADR-004 Worktree-isolated development.

# SQLite databases — separate path so v0.3 server is unaffected
AUDIT_PLAN_CACHE_PATH=/Users/wayne/.ai-browser-auditor-v1/plan-cache.db
AUDIT_MEMORY_PATH=/Users/wayne/.ai-browser-auditor-v1/memory.db

# Reports directory — separate
AUDIT_REPORTS_DIR=/Users/wayne/.ai-browser-auditor-v1/reports

# Cost guard ledger (M5-6) — keep v1 spend separate from any v0.3 default
AUDIT_COST_LEDGER_PATH=/Users/wayne/.ai-browser-auditor-v1/cost-ledger.json

# Result cache (M9-4) — keep v1 cache separate from any v0.3 default
AUDIT_RESULT_CACHE_PATH=/Users/wayne/.ai-browser-auditor-v1/result-cache.db
# AUDIT_RESULT_CACHE_TTL_MS=86400000     # default 24h
# AUDIT_RESULT_CACHE_DISABLED=1          # uncomment to bypass cache entirely

# Primitive artefacts roots — isolate v1 see/act/extract/judge/compare per-call subdirs
AUDIT_SEES_DIR=/Users/wayne/.ai-browser-auditor-v1/sees
AUDIT_ACTS_DIR=/Users/wayne/.ai-browser-auditor-v1/acts
AUDIT_EXTRACTS_DIR=/Users/wayne/.ai-browser-auditor-v1/extracts
AUDIT_JUDGES_DIR=/Users/wayne/.ai-browser-auditor-v1/judges
AUDIT_COMPARES_DIR=/Users/wayne/.ai-browser-auditor-v1/compares

# Mark this as development (some primitives may behave differently)
PIXELCHECK_ENV=development
PIXELCHECK_VERSION=v1.0.0-dev
