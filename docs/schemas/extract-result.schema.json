{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/anthropics/ai-browser-auditor/blob/main/docs/schemas/extract-result.schema.json",
  "title": "ExtractResult",
  "description": "MCP tool envelope returned by `extract` (N-4 primitive). Schema-bound structured extraction: caller passes a JSON Schema describing the desired shape, the primitive runs Stagehand's extract() and returns matching `data` plus DOM summary, console errors, and screenshot.",
  "x-result-schema-version": "1.2.0",
  "$ref": "#/definitions/ExtractResult",
  "definitions": {
    "ExtractResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "url_input": {
          "type": "string"
        },
        "url_final": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "loaded_at": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "error": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "const": "stagehand"
        },
        "data": {},
        "schema_used": {},
        "instruction_used": {
          "type": "string"
        },
        "selector_used": {
          "type": "string"
        },
        "dom": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "interactive_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "headings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "summary": {
                  "type": "string"
                },
                "text_excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "interactive_count",
                "headings",
                "summary"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "console": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "errors_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "console",
                          "pageerror",
                          "requestfailed"
                        ]
                      },
                      "text": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "text",
                      "timestamp"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "errors_count",
                "errors"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "persona_id": {
          "type": "string"
        },
        "artifacts_dir": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "cache": {
          "type": "object",
          "properties": {
            "hit": {
              "type": "boolean"
            },
            "age_ms": {
              "type": "number",
              "minimum": 0
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cost_saved_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "hit",
            "age_ms",
            "key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url_input",
        "url_final",
        "title",
        "loaded_at",
        "status",
        "engine",
        "dom",
        "console",
        "screenshot",
        "persona_id",
        "artifacts_dir",
        "cost_usd",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  }
}
