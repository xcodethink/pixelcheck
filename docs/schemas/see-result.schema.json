{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xcodethink/ai-browser-auditor/blob/main/docs/schemas/see-result.schema.json",
  "title": "SeeResult",
  "description": "MCP tool envelope returned by `see` (N-1 primitive). One-shot navigation snapshot: DOM summary, console errors, screenshot, and an optional vision note.",
  "x-result-schema-version": "1.3.0",
  "$ref": "#/definitions/SeeResult",
  "definitions": {
    "SeeResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "url_input": {
          "type": "string"
        },
        "url_final": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "loaded_at": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        },
        "error": {
          "type": "string"
        },
        "dom": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "interactive_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "headings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "summary": {
                  "type": "string"
                },
                "text_excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "interactive_count",
                "headings",
                "summary"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "console": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "errors_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "console",
                          "pageerror",
                          "requestfailed"
                        ]
                      },
                      "text": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "text",
                      "timestamp"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "errors_count",
                "errors"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona_id": {
          "type": "string"
        },
        "artifacts_dir": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "cache": {
          "type": "object",
          "properties": {
            "hit": {
              "type": "boolean"
            },
            "age_ms": {
              "type": "number",
              "minimum": 0
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "cost_saved_usd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "hit",
            "age_ms",
            "key"
          ],
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "collected_at": {
              "type": "string",
              "enum": [
                "always",
                "on_failure"
              ],
              "default": "always"
            },
            "popups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "url": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body_text": {
                    "type": "string"
                  },
                  "closed": {
                    "type": "boolean"
                  },
                  "last_seen_url": {
                    "type": "string"
                  },
                  "last_seen_title": {
                    "type": "string"
                  }
                },
                "required": [
                  "index",
                  "url",
                  "title",
                  "body_text",
                  "closed"
                ],
                "additionalProperties": false
              }
            },
            "network": {
              "type": "object",
              "properties": {
                "request_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "failure_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "requests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "resource_type": {
                        "type": "string"
                      },
                      "status": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "duration_ms": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "size_bytes": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "from_cache": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "url",
                      "method",
                      "status",
                      "duration_ms",
                      "size_bytes"
                    ],
                    "additionalProperties": false
                  }
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "method": {
                        "type": "string"
                      },
                      "resource_type": {
                        "type": "string"
                      },
                      "error_text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url",
                      "method",
                      "error_text"
                    ],
                    "additionalProperties": false
                  }
                },
                "truncated_count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "request_count",
                "failure_count",
                "requests",
                "failures"
              ],
              "additionalProperties": false
            },
            "cookies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "expires": {
                    "type": "number"
                  },
                  "http_only": {
                    "type": "boolean"
                  },
                  "secure": {
                    "type": "boolean"
                  },
                  "same_site": {
                    "type": "string",
                    "enum": [
                      "Strict",
                      "Lax",
                      "None"
                    ]
                  }
                },
                "required": [
                  "name",
                  "value",
                  "domain",
                  "path",
                  "expires",
                  "http_only",
                  "secure"
                ],
                "additionalProperties": false
              }
            },
            "storage": {
              "type": "object",
              "properties": {
                "local_storage": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "session_storage": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "local_storage_keys": {
                  "type": "integer",
                  "minimum": 0
                },
                "session_storage_keys": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "local_storage",
                "session_storage",
                "local_storage_keys",
                "session_storage_keys"
              ],
              "additionalProperties": false
            },
            "performance": {
              "type": "object",
              "properties": {
                "collected": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "visual": {
              "type": "object",
              "properties": {
                "scored": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "url_input",
        "url_final",
        "title",
        "loaded_at",
        "status",
        "dom",
        "console",
        "screenshot",
        "note",
        "persona_id",
        "artifacts_dir",
        "cost_usd",
        "duration_ms"
      ],
      "additionalProperties": false
    }
  }
}
