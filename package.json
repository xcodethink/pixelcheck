{
  "name": "ai-browser-auditor",
  "version": "0.3.0",
  "description": "AI-driven post-deployment UX audit. Real browser, real personas, real scenarios, commercial-grade evaluation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ai-audit": "dist/cli.js",
    "ai-audit-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "audit": "tsx src/cli.ts",
    "test": "npm run lint:no-console && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --coverage.thresholdAutoUpdate=false",
    "lint:no-console": "bash scripts/check-no-console.sh",
    "schemas": "tsx scripts/export-result-schemas.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "browser",
    "audit",
    "ux",
    "playwright",
    "stagehand",
    "claude",
    "computer-use",
    "e2e"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@browserbasehq/stagehand": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axe-core": "^4.11.2",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "odiff-bin": "^4.3.2",
    "ora": "^8.1.0",
    "p-limit": "^6.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.49.0",
    "sharp": "^0.34.5",
    "stealth-core": "file:../stealth-core",
    "ws": "^8.20.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4",
    "zod-to-json-schema": "^3.25.2"
  }
}
